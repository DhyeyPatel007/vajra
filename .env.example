# Nebius Token Factory API Key (Server-side only — NEVER prefix with NEXT_PUBLIC_)
NEBIUS_API_KEY=your_nebius_token_factory_api_key_here

# Nebius Token Factory OpenAI-compatible base URL
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# Copy exact model IDs from your Nebius Token Factory catalog console:
# Primary model (Nemotron Super = medium)
NEBIUS_MODEL_SUPER=nvidia/nemotron-3-super-120b-a12b
# Fallback model (Nemotron Ultra = large, used only if Super fails)
NEBIUS_MODEL_ULTRA=nvidia/Nemotron-3-Ultra-550b-a55b

# Default to true for zero-API-call local building & testing. Set to false to enable live calls by default.
VAJRA_MOCK_MODE=true
