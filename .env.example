# ==============================================================================
# VAJRA RUNTIME PROVIDER CONFIGURATION
# ==============================================================================

# Provider switch: "nebius" (default, Token Factory submission path) or "nvidia" (check path only)
VAJRA_PROVIDER=nebius

# Mock mode: true (default, zero API calls, verified local kernels) or false (live LLM generation)
VAJRA_MOCK_MODE=true

# ------------------------------------------------------------------------------
# 1. NEBIUS TOKEN FACTORY (Final Submission Path)
# ------------------------------------------------------------------------------
# Server-side only — NEVER prefix with NEXT_PUBLIC_
NEBIUS_API_KEY=your_nebius_api_key_here
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL_SUPER=nvidia/nemotron-3-super-120b-a12b
NEBIUS_MODEL_ULTRA=nvidia/Nemotron-3-Ultra-550b-a55b

# ------------------------------------------------------------------------------
# 2. NVIDIA API (Temporary Check Path Only)
# ------------------------------------------------------------------------------
# Server-side only — NEVER prefix with NEXT_PUBLIC_
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL_SUPER=nvidia/nemotron-3-super-120b-a12b
NVIDIA_MODEL_NANO=nvidia/llama-3.1-nemotron-70b-instruct

# ------------------------------------------------------------------------------
# 3. TAVILY API (Optional Grounding & Bring Your Own Kernel Extract)
# ------------------------------------------------------------------------------
# Server-side only — NEVER prefix with NEXT_PUBLIC_
TAVILY_API_KEY=your_tavily_api_key_here
